[core]
name:null1
maxHp:0
mass:0
price:0
radius:0
#此模板在"基础模板"上修改
isBuilding:true
#此代码规定建筑范围
footprint:0,0,0,0
constructionFootprint:0,0,0,0

stayNeutral:true
createNeutral:true
disableDeathOnZeroHp:true
canNotBeDamaged:true
canNotBeDirectlyAttacked:true
dont_load:true
[graphics]
#图像节需要设置主体图像
image:null1.png
scaleImagesTo:20
[attack]
canAttack:false
[movement]
movementType:BUILDING